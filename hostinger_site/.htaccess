# ── Encoding ──────────────────────────────────────────────
AddDefaultCharset UTF-8

# ── Rewrite engine ────────────────────────────────────────
Options -Indexes
RewriteEngine On

# ── HTTPS redirect (http → https) ─────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── WWW consistency (non-www → www) ───────────────────────
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Redirecciones páginas antiguas → secciones del home ───
# Deben ir ANTES del trailing-slash rule para resolverse en un solo salto.
RewriteRule ^servicios/?$                          https://www.vantelia.es/#servicios  [R=301,L]
RewriteRule ^testimonios/?$                        https://www.vantelia.es/#testimonios [R=301,L]
RewriteRule ^nosotros/?$                           https://www.vantelia.es/#nosotros   [R=301,L]
RewriteRule ^noticias/?$                           https://www.vantelia.es/            [R=301,L]
RewriteRule ^seo-para-empresas-b2b/?$              https://www.vantelia.es/#servicios  [R=301,L]
RewriteRule ^consultoria-ia-para-empresas/?$       https://www.vantelia.es/#servicios  [R=301,L]
RewriteRule ^automatizacion-con-ia-para-empresas/? https://www.vantelia.es/#servicios  [R=301,L]

# ── Trailing-slash enforcement para directorios activos ───
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^ %{REQUEST_URI}/ [R=301,L]

# ── Redirecciones legacy ──────────────────────────────────
Redirect 301 /contacto  /consultas/
Redirect 301 /contacto/ /consultas/

# ── 404 personalizado ────────────────────────────────────
ErrorDocument 404 /404.html

# ── Compresión GZIP ───────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript \
    application/javascript application/json application/xml \
    image/svg+xml font/woff2
</IfModule>

# ── Cache headers ─────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 0 seconds"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript        "access plus 1 year"
  ExpiresByType image/png              "access plus 6 months"
  ExpiresByType image/jpeg             "access plus 6 months"
  ExpiresByType image/webp             "access plus 6 months"
  ExpiresByType image/svg+xml          "access plus 6 months"
  ExpiresByType image/x-icon           "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType font/woff              "access plus 1 year"
</IfModule>

# ── Security headers ──────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
