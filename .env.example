# === Outreach / Captacion ===
OUTREACH_DB_PATH=
OUTREACH_TRACKING_SECRET=cambia-este-secreto-largo-y-aleatorio
OUTREACH_TRACKING_BASE_URL=https://app.vantelia.es
# Tracking es opt-in explicito. true = activa pixel open + link click tracking.
OUTREACH_TRACKING_ENABLED=true
OUTREACH_UNSUBSCRIBE_EMAIL=baja@vantelia.es
OUTREACH_BCC=
OUTREACH_DOMAIN_DAILY_CAP=3
OUTREACH_RESPECT_WINDOW=true
OUTREACH_START_HOUR=9
OUTREACH_END_HOUR=19
OUTREACH_SKIP_WEEKEND=true
OUTREACH_MSGID_DOMAIN=vantelia.es
# Proof line opcional inyectada en cold. Ej:
# OUTREACH_PROOF_LINE=Lo monte para Clinica Dental Sonrisa (Madrid). Reciben 22 consultas/semana sin tocar nada.
OUTREACH_PROOF_LINE=
# Demo personalizada por prospect (Fase 2). URL base publica donde vive /d/{slug}.
# Si vacio, usa APP_BASE_URL.
OUTREACH_DEMO_BASE_URL=
# cliente_id en config.json que el widget de la demo usa como cerebro (RAG).
# Por defecto "demo".
OUTREACH_DEMO_CLIENT_ID=demo
# Cliente_id en config.json que actua de "agenda interna" para reservar las demos
# de 15 min con Pablo (booking.enabled=true). Si lo defines, /d/{slug} muestra
# selector de fecha + huecos libres y reserva via /agendar (sin Calendly/cal.com).
# Recomendado: crear cliente "vantelia" en config.json con tu horario.
OUTREACH_BOOKING_CLIENTE_ID=
# Duracion en minutos mostrada en CTAs de email ("Reservar X min"). Default 15.
# Independiente de booking.slot_minutes del cliente; el CTA es solo copy.
OUTREACH_BOOKING_MINUTES=15
# Fallback externo (solo se usa si OUTREACH_BOOKING_CLIENTE_ID esta vacio).
# Calendly/cal.com/Google Appointment. Vacio = sin calendario externo.
OUTREACH_CALENDAR_URL=
GOOGLE_PLACES_API_KEY=AIzaSyDatktaC5hiydVwYePnORbqQq18uSRK7uk
# IMAP (autodeteccion de respuestas para outreach)
# Si IMAP_HOST esta vacio el poller no arranca. Recomendado: usar el mismo
# buzon desde el que envias outreach (OUTREACH_FROM_EMAIL / SMTP_USERNAME).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_USE_SSL=true
OUTREACH_IMAP_INTERVAL_MINUTES=10
OUTREACH_IMAP_LOOKBACK_DAYS=14

# Modo autonomo (captacion pasiva): el worker hace discovery + cold + followups
# solo. enabled en DB se gestiona desde el panel; el env aqui es kill switch.
OUTREACH_AUTONOMOUS_ENABLED=false
OUTREACH_AUTONOMOUS_TICK_MINUTES=60
OUTREACH_AUTONOMOUS_DISCOVERY_HOURS=6

# =====================================================================
# Captacion Instagram (DMs)
# =====================================================================
# Modo HIBRIDO COMPLIANT por defecto: NO se envia automaticamente. El sistema
# genera drafts y el operador los envia con 1-clic via ig.me deep link.
# Activar autosend Playwright sin permiso de Meta puede provocar bloqueo de
# la cuenta IG. Usa cuenta secundaria si activas el modo agresivo.
IG_DB_PATH=storage/instagram/instagram.db

# Graph API (opcional, oficial). Habilita Business Discovery (lookup perfiles
# publicos) y reply polling. Requiere cuenta IG Business propia + app Meta
# con permisos instagram_basic + instagram_manage_messages.
IG_GRAPH_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_GRAPH_API_VERSION=v22.0
IG_REPLIES_INTERVAL_MINUTES=10

# Modo agresivo (Playwright). NO recomendado salvo cuenta sacrificable.
IG_AUTOSEND_ENABLED=false
IG_AUTOSEND_SESSION_PATH=storage/instagram/session.json
IG_AUTOSEND_DAILY_CAP=25
IG_AUTOSEND_MIN_DELAY_SECONDS=30
IG_AUTOSEND_MAX_DELAY_SECONDS=90

# Autopilot IG: discovery + generacion de drafts (envio sigue manual salvo
# IG_AUTOSEND_ENABLED). Kill switch dual: env + flag en DB.
IG_AUTONOMOUS_ENABLED=false
IG_AUTONOMOUS_TICK_MINUTES=60
IG_AUTONOMOUS_DISCOVERY_HOURS=12

# Ventana laboral para envios IG (zona horaria DEFAULT_TIMEZONE).
IG_RESPECT_WINDOW=true
IG_START_HOUR=10
IG_END_HOUR=20
IG_SKIP_WEEKEND=true

# Rate limit del scrape publico read-only (segundos entre requests).
IG_PUBLIC_RATE_LIMIT_SEC=2.0
IG_PUBLIC_USER_AGENT=Mozilla/5.0 (compatible; VanteliaResearch/1.0; +https://www.vantelia.es)

# ---------------------------------------------------------------------------
# Captacion WhatsApp (cold outbound via WhatsApp Web con TU numero, Playwright).
# Coge telefonos de los prospects de Captacion (outreach.db). Un mensaje por
# telefono (dedup). RIESGO de bloqueo Meta: usar numero secundario.
# ---------------------------------------------------------------------------
WA_AUTOSEND_ENABLED=false
WA_DB_PATH=storage/whatsapp/whatsapp.db
WA_SESSION_DIR=storage/whatsapp/profile
WA_QR_PATH=storage/whatsapp/qr.png
WA_AUTOSEND_HEADLESS=true
WA_AUTOSEND_DAILY_CAP=20
WA_AUTOSEND_MIN_DELAY_SEC=60
WA_AUTOSEND_MAX_DELAY_SEC=240
