; Puente de Sara: ElevenLabs -> este Asterisk -> centralita de Zadarma.
; Plantilla: montar.sh sustituye los __MARCADORES__ con los datos del .env de la app.
[global]
type=global
user_agent=Vantelia

[t-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5099

[t-udp]
type=transport
protocol=udp
bind=0.0.0.0:5099

; --- ElevenLabs entra con usuario y clave (sus IP cambian en cada llamada y solo son fijas
; en su plan Enterprise). Con identify_by=auth_username el endpoint TIENE que llamarse igual
; que el usuario: con otro nombre Asterisk respondia "No matching endpoint found".
[sara_el]
type=auth
auth_type=userpass
username=sara_el
password=__CLAVE_ELEVENLABS__

[sara_el]
type=aor
max_contacts=1

[sara_el]
type=endpoint
transport=t-tcp
context=desde-elevenlabs
disallow=all
allow=alaw,ulaw
auth=sara_el
aors=sara_el
identify_by=auth_username
direct_media=no
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733

; --- Salida por la centralita de Zadarma, registrado como un telefono mas (la extension).
[zadarma]
type=auth
auth_type=userpass
username=__ZADARMA_USUARIO__
password=__ZADARMA_CLAVE__

[zadarma]
type=aor
contact=sip:pbx.zadarma.com:5060
qualify_frequency=60

[zadarma]
type=endpoint
transport=t-udp
context=desde-zadarma
disallow=all
allow=alaw
outbound_auth=zadarma
aors=zadarma
from_user=__ZADARMA_USUARIO__
from_domain=pbx.zadarma.com
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733

[zadarma]
type=registration
transport=t-udp
outbound_auth=zadarma
server_uri=sip:pbx.zadarma.com
client_uri=sip:__ZADARMA_USUARIO__@pbx.zadarma.com
contact_user=__ZADARMA_USUARIO__
retry_interval=60
forbidden_retry_interval=600
; Sin esto Asterisk deja de reintentar tras 10 fallos y el puente se queda vivo pero sin
; registrar si Zadarma cae un rato (revision de Astra, 28-sep-2026).
max_retries=100000
auth_rejection_permanent=no
expiration=300

[zadarma]
type=identify
endpoint=zadarma
match=pbx.zadarma.com
