{
  "permissions": {
    "allow": [
      "PowerShell(cd \"D:\\\\Vantelia\"; powershell -ExecutionPolicy Bypass -File .\\\\deploy\\\\deploy.ps1)",
      "Bash(claude plugin *)",
      "PowerShell(Get-ChildItem *)",
      "Bash(xargs wc *)",
      "PowerShell(& \"D:\\\\Vantelia\\\\scripts\\\\deploy-ftp.ps1\")",
      "PowerShell(python \"D:\\\\Vantelia\\\\scripts\\\\fix-favicon.py\")",
      "Bash(python -m pytest tests/test_api_smoke.py -q)",
      "Bash(curl -s \"https://www.vantelia.es/demo/\")",
      "Bash(git add *)",
      "Read(D:/Vantelia/.env)",
      "Read(D:/Vantelia/.env.ftp)",
      "Read(D:/Vantelia/.sincronia/token)",
      "Read(C:/Users/Pablo/.ssh/**)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)",
      "PowerShell(*deploy.ps1*)"

    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/sincronia.py\" --al-dia claude --hook 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Sincronía: poniéndome al día"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/sincronia.py\" --al-dia claude --hook --solo-novedades 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": true
  }
}
